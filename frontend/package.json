{
  "name": "aisstream-map-card",
  "version": "0.1.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -f ../custom_components/aisstream/frontend/*.js && esbuild src/aisstream-map-card.ts --bundle --splitting --format=esm --target=es2021 --minify --legal-comments=eof --loader:.css=text --chunk-names=[name]-[hash] --outdir=../custom_components/aisstream/frontend",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "lit": "^3.2.0",
    "maplibre-gl": "^5.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
